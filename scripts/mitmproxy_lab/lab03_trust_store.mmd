    classDef os fill:#e3eaf3,stroke:#3a5e89,color:#1a2a3a
    classDef store_sys fill:#fff4d6,stroke:#b58900,color:#5c4400
    classDef store_nss fill:#f4e8ff,stroke:#7e57c2,color:#3d2466
